program {
    struct Rectangulo { int base; int altura; }
    Rectangulo r;
    r.base = 10;
    r.altura = 5;
    int area = r.base * r.altura;
    print(area);
    int a = 7;
    int b = 2;
    float division = (float)a / (float)b;
    print(division);
    float pi = 3.14;
    int pi_entero = (int)pi;
    print(pi_entero);
}
